<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Integra7AuralAlchemist.ViewModels"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="800"
             x:Class="Integra7AuralAlchemist.Views.DuplicateScanView"
             x:DataType="vm:DuplicateScanViewModel">

    <!-- The patches saved more than once, in families, each row with a tick box.

         What a group means is on the panel and not left to be guessed, because the grouping is transitive:
         every member is near at least one other member and no more than that is promised. The sentence is
         written by LibraryListing.DuplicateSummary, where it has tests, and it quotes the threshold the scan
         actually ran at rather than whatever the box says now.

         The two actions are above the groups rather than at the bottom. A family of duplicates is a handful
         of rows and a library can hold many families, so the list scrolls and the buttons would otherwise be
         somewhere below the fold, reached by scrolling past everything the user has just ticked.

         No ToolTip on any of these. The tick boxes and the Scan button are pressed repeatedly while a library
         is being tidied, and a tooltip is a popup that swallows the click on the control it describes. -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="10" Margin="0,0,16,0">

            <TextBlock Text="Duplicates" FontWeight="Bold" />

            <!-- The threshold, in the unit the report is counted in: parameter values that differ. Nought
                 means identical, which is the other thing people come here for — the file copied in twice.
                 Changing it does not re-run the scan; the button does, and until it is pressed the summary
                 goes on quoting the threshold the rows on screen were actually found with. -->
            <TextBlock Text="Treat as the same sound when at most this many parameters differ"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SnMutedTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Value="{Binding Threshold}" Minimum="0" Maximum="100" Increment="1"
                               FormatString="0" Width="110" />
                <Button Content="Scan" Command="{Binding ScanAsync}" Padding="12,2" />
            </StackPanel>

            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />

            <!-- Both collapse until something has been found, rather than sitting there as two dead buttons
                 under a sentence saying there is nothing to act on. -->
            <Button Content="Compare these two"
                    Command="{Binding CompareTickedAsync}"
                    IsVisible="{Binding CanCompare}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="{Binding DeleteLabel}"
                    Command="{Binding DeleteTickedAsync}"
                    IsVisible="{Binding CanDelete}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <Border Background="{StaticResource SnPanelBackgroundBrush}"
                                BorderBrush="{StaticResource SnStatusBarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel Orientation="Vertical" Spacing="6">
                                <TextBlock Text="{Binding Caption}"
                                           Foreground="{StaticResource SnMutedTextBrush}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DuplicateRowViewModel">
                                            <!-- The tick box takes the whole row, and what it labels is the
                                                 file name rather than the name: four saves of one sound
                                                 share a name, and the file name, the date and the rating
                                                 are the three things that tell them apart. The name is
                                                 above them all the same, because it is what the user
                                                 recognises the family by. -->
                                            <CheckBox IsChecked="{Binding IsTicked, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{StaticResource SnMutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Modified}"
                                                                   Foreground="{StaticResource SnMutedTextBrush}" />
                                                        <TextBlock Text="{Binding Stars}"
                                                                   Foreground="{StaticResource SnRatingStarBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Last, because it is the way out rather than something to do here, and because a button that
                 closes the panel sitting above the rows would be the easiest one to hit by accident. -->
            <Button Content="Close" Command="{Binding Close}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
