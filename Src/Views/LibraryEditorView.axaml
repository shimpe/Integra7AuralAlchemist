<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Integra7AuralAlchemist.ViewModels"
             xmlns:local="clr-namespace:Integra7AuralAlchemist.Views"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="800"
             x:Class="Integra7AuralAlchemist.Views.LibraryEditorView"
             x:DataType="vm:LibraryEditorViewModel">

    <!-- What the selected snapshot says about itself, and the things that can be done to it. Moved out
         of LibraryView unchanged: every binding path below is the same one it was, against a view model that
         now holds only these fields. The panel's ground and border stay with the list's Grid, which is what
         places this control in its column.

         The three tooltips in here are on buttons pressed once in a while rather than repeatedly, which is
         the shape of the swallowed-click bug LibraryView's header comment describes; every control that is
         clicked often has its explanation on screen instead. -->

    <Panel>
        <TextBlock Text="Select a snapshot to see and change what it says about itself."
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource SnMutedTextBrush}"
                   IsVisible="{Binding !HasSelection}" />

        <ScrollViewer IsVisible="{Binding HasSelection}"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Spacing="6">
                <TextBlock Text="Name" Foreground="{StaticResource SnMutedTextBrush}" />
                <!-- The name inside the snapshot, which is not the file's own name: renaming here
                     changes what the library and the instrument call the sound and leaves the file
                     where it is, under the name the user gave it. -->
                <TextBox Text="{Binding EditName, Mode=TwoWay}" />

                <TextBlock Text="Category" Foreground="{StaticResource SnMutedTextBrush}" />
                <!-- Disabled for a Studio Set, which is sixteen parts each with a category of its
                     own and has no single one to name. Disabled rather than hidden so that a
                     hand-edited file which does carry one still shows what it says. -->
                <ComboBox ItemsSource="{Binding EditCategoryLabels}"
                          SelectedItem="{Binding EditCategoryLabel, Mode=TwoWay}"
                          IsEnabled="{Binding SelectedIsTone}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Text="Tags, separated by commas"
                           Foreground="{StaticResource SnMutedTextBrush}" />
                <TextBox Text="{Binding EditTags, Mode=TwoWay}" />

                <TextBlock Text="Notes" Foreground="{StaticResource SnMutedTextBrush}" />
                <TextBox Text="{Binding EditNotes, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="110" />

                <TextBlock Text="Rating" Foreground="{StaticResource SnMutedTextBrush}" />
                <local:RatingView DataContext="{Binding EditRating}" />

                <CheckBox IsChecked="{Binding EditFavourite, Mode=TwoWay}" Content="Favourite" />

                <Button Content="Save changes"
                        Command="{Binding SaveChanges}"
                        IsEnabled="{Binding CanSaveChanges}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,6,0,0" />

                <!-- Load goes through the window's own restore paths, so a tone still refuses to go
                     into a part holding a different engine, with the message it already gives. The
                     line under the button is that condition said before it is hit, because the
                     remedy — select a part holding that kind of tone — is not obvious from the
                     refusal alone. -->
                <Button Content="Load into the instrument"
                        Command="{Binding LoadSelectedAsync}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <TextBlock Text="A Studio Set replaces the one in the instrument. A tone goes into the part selected on the Parameters tab, which must already hold a tone of the same kind."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SnMutedTextBrush}" />

                <!-- The mark is per engine, so this is offered only for a tone whose engine this
                     build recognises — a Studio Set has sixteen of them and no single one to be
                     the starting point for. A tooltip is safe here: this is pressed once in a
                     while, not repeatedly, which is the shape of the swallowed-click bug. -->
                <Button Content="Use as the init tone"
                        Command="{Binding MarkAsInitTone}"
                        IsEnabled="{Binding CanMarkAsInitTone}"
                        ToolTip.Tip="Make this the tone the Init Tone button starts from, for parts holding this kind of tone. Replaces the bundled starting point."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding InitToneNote}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SnMutedTextBrush}" />

                <!-- The kept copies. Collapses entirely when there are none, which is every snapshot
                     until the first time it is written over — a caption above an empty box would read
                     as a control that is broken rather than one that is unused.

                     No tooltip on the Restore button: it sits beside a drop-down the user opens
                     repeatedly while looking for the right date, and a tooltip is a popup that
                     swallows the click on its own control. -->
                <StackPanel Orientation="Vertical" Spacing="4" IsVisible="{Binding HasVersions}">
                    <TextBlock Text="Earlier versions"
                               Foreground="{StaticResource SnMutedTextBrush}" />
                    <ComboBox ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PatchVersionViewModel">
                                <TextBlock Text="{Binding Written}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Restore this version"
                            Command="{Binding RestoreVersionAsync}"
                            IsEnabled="{Binding CanRestore}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </StackPanel>

                <!-- Nothing is read or written here: the Compare tab takes the file from the
                     list and fills whichever of its two slots is free. Pressed once in a
                     while, so a tooltip is safe for the same reason it is on the two buttons
                     above. -->
                <Button Content="Compare this"
                        Command="{Binding CompareThisAsync}"
                        IsEnabled="{Binding HasSelection}"
                        ToolTip.Tip="Send this snapshot to the Compare tab, to see how it differs from another one or from what the instrument holds now."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <!-- The one button in this tab that asks first, because it is the one that takes
                     the sound out of the library: the file leaves the folder, and a copy stays in
                     the history folder beside it, which is somewhere the user has to know about to
                     find. Pressed rarely, so a tooltip is safe here for the same reason it is on
                     the button above. -->
                <Button Content="Delete from the library"
                        Command="{Binding DeleteSelectedAsync}"
                        IsEnabled="{Binding HasSelection}"
                        ToolTip.Tip="Remove this snapshot from the library. The file leaves the folder — a copy is kept in the history folder beside your library."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
