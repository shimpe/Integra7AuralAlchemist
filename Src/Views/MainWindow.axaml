<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Integra7AuralAlchemist.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1600"
        d:DesignHeight="800"
        x:Class="Integra7AuralAlchemist.Views.MainWindow"
        xmlns:local="clr-namespace:Integra7AuralAlchemist.Views"
        xmlns:behaviors="using:Integra7AuralAlchemist.Behaviors"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/integra7-icon.ico"
        Title="Integra-7 Aural Alchemist">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <!-- No Ctrl+Z / Ctrl+Y binding here, deliberately. Avalonia evaluates KeyBindings by walking up
         from the focused element BEFORE raising KeyDown on it (KeyboardDevice.ProcessRawEvent), and
         KeyBinding.TryHandle does not look at whether the event was already handled. A window-level
         binding therefore always beats a focused TextBox's own undo — so Ctrl+Z while typing a Studio
         Set name, a search box or a grid's string editor would undo the last *parameter* edit and
         write it to the instrument, rather than undoing the typing. A keystroke that means "take back
         what I just typed" must not send MIDI.

         Undo and Redo are on the toolbar instead. Restoring the shortcut needs the command to report
         CanExecute=false while a text input has focus (TryHandle does not fire, and does not swallow,
         when it cannot execute) — that is the fix, and it is more than a binding. -->
    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Padding"
                    Value="3,0,3,0" />
            <Setter Property="MinHeight"
                    Value="40" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
        <!-- Draggable title-bar strip: FluentAvalonia 3 removed TitleBarHitTestType,
             so with ExtendsContentIntoTitleBar the window is movable only via a
             non-focusable region inside TitleBar.Height (32px). This strip is that
             drag handle (a Border/TextBlock are non-focusable, so FA treats it as drag area). -->
        <Border Grid.Row="0"
                Height="32"
                Background="Transparent"
                PointerPressed="TitleBarDragStrip_PointerPressed">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Margin="10,0">
                <!-- Same artwork as the window/exe icon; a Border clips it to a rounded
                     tile so the opaque square does not read as a sticker on the dark strip. -->
                <Border Width="20"
                        Height="20"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <Image Source="/Assets/integra7-icon.png"
                           Width="20"
                           Height="20" />
                </Border>
                <TextBlock Text="Integra-7 Aural Alchemist"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#BF696969"
                BorderBrush="#BF696969"
                BorderThickness="2"
                CornerRadius="10"
                Padding="10"
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="900"
                Height="300"
                IsVisible="{Binding IsSyncing}"
                ZIndex="100">
            <StackPanel Orientation="Vertical">
                <TextBlock FontSize="150" Text="Syncing..." HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsVisible="{Binding IsSyncing}"
                           ZIndex="110" />
                <TextBlock FontSize="25" Text="{Binding SyncInfo}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsVisible="{Binding IsSyncing}"
                           ZIndex="110" />
            </StackPanel>
        </Border>

        <!-- SelectedIndex is bound so the Mixer's Open button can bring the Parameters tab to the front:
             selecting a part inside it is no use while the Mixer tab is still showing. -->
        <TabControl Grid.Column="0" Grid.Row="1" SelectedIndex="{Binding TopTabIndex, Mode=TwoWay}">
            <TabItem Header="Parameters">
                <Grid ColumnDefinitions="*"
                      RowDefinitions="Auto,*">
                    <!-- The toolbar scrolls sideways rather than clipping. It is a fixed row of twelve buttons
                         now that both saves have an Export beside them, which at a narrow window width put the
                         last of them past the right edge with nothing to reach them by; a StackPanel does not
                         clip visibly, so the button was simply not there. Vertical scrolling is off so the row
                         cannot grow, and the horizontal bar only appears when it is needed. -->
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Button IsEnabled="{Binding RescanButtonEnabled}"
                                    Command="{Binding RescanMidiDevicesAsync}">
                                Rescan Midi Devices
                            </Button>
                            <Button Command="{Binding PlayNoteAsync}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Play Note
                            </Button>
                            <!-- Play Phrase, Stop Phrase and Panic used to sit here. They moved to the
                                 status bar beside Undo, Redo and Compare, because they are the same kind
                                 of thing: reached for at any moment, from any tab, and not part of the
                                 Parameters tab's own work. Panic in particular is the one button whose
                                 whole value is being where you already are. Play Note stays, because it
                                 sounds the *selected part* and only this tab has a selected part. -->
                            <Button Command="{Binding SaveUserTone}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                            <Binding Path="CurrentPartIsNotCommonPart" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Save User Tone
                            </Button>
                            <!-- Save writes into the library — searchable, filterable, one folder to back up — and
                                 Export writes a snapshot file wherever the user likes. Both read the same 53 blocks
                                 out of the instrument; they differ only in where the file lands and in whether a
                                 name, category, tags and a rating are asked for first. -->
                            <Button Command="{Binding SaveStudioSetAsync}"
                                    ToolTip.Tip="Read the Studio Set currently in the instrument — its common settings, effects and all 16 parts — and save it into the library.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Save Studio Set…
                            </Button>
                            <Button Command="{Binding ExportStudioSetAsync}"
                                    ToolTip.Tip="Read the Studio Set currently in the instrument and write it to a file anywhere you like, outside the library.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Export Studio Set…
                            </Button>
                            <Button Command="{Binding LoadStudioSetAsync}"
                                    ToolTip.Tip="Write a saved Studio Set back into the instrument. This overwrites the Studio Set currently loaded there, including any edits you have not saved.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Load Studio Set…
                            </Button>
                            <Button Command="{Binding SaveToneAsync}"
                                    ToolTip.Tip="Read the tone currently loaded into the selected part — every one of its parameters — and save it into the library.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                            <Binding Path="CurrentPartIsNotCommonPart" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Save Tone…
                            </Button>
                            <Button Command="{Binding ExportToneAsync}"
                                    ToolTip.Tip="Read the tone currently loaded into the selected part and write it to a file anywhere you like, outside the library.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                            <Binding Path="CurrentPartIsNotCommonPart" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Export Tone…
                            </Button>
                            <Button Command="{Binding LoadToneAsync}"
                                    ToolTip.Tip="Write a saved tone into the selected part. This overwrites the tone currently in that part, including any edits you have not saved, and the part must already hold a tone of the same kind — select a preset of that kind on it first.">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Connected" />
                                            <Binding Path="!IsSyncing" />
                                            <Binding Path="CurrentPartIsNotCommonPart" />
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                Load Tone…
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <TabControl HorizontalContentAlignment="Left"
                                TabStripPlacement="Left"
                                Grid.Row="1"
                                Grid.Column="0"
                                ItemsSource="{Binding PartViewModels}"
                                SelectedIndex="{Binding CurrentPartSelection, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <!-- this is the header template -->
                            <DataTemplate>
                                <TextBlock Text="{Binding Header}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="vm:PartViewModel">
                                <Panel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="10,5,0,0"
                                                Spacing="50"
                                                IsVisible="{Binding IsCommonTab}">
                                        <TabControl TabStripPlacement="Top"
                                                    VerticalAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    behaviors:TabControlBehaviors.SelectTabByTag="{Binding CommonTabKey}">
                                            <TabItem Header="Setup">
                                                <local:ParameterCollection Parameters="{Binding SetupParameters}"
                                                                           SearchText="{Binding SearchTextSetup, Mode=TwoWay}" />
                                            </TabItem>
                                            <TabItem Header="System">
                                                <local:SystemEditorView DataContext="{Binding SystemEditor}" />
                                            </TabItem>
                                            <TabItem Header="Common">
                                                <local:StudioSetCommonEditorView DataContext="{Binding StudioSetCommonEditor}" />
                                            </TabItem>
                                            <!-- Tagged so the Mixer tab's strips can navigate here: a strip's
                                                 send knobs say how much of a part is fed to the one shared
                                                 chorus and the one shared reverb, and these are the editors
                                                 for what those units do. The "-FRIENDLY" suffix keeps them
                                                 apart from COMMON-CHORUS / COMMON-REVERB, which are the raw
                                                 grids for the same domains under Advanced. -->
                                            <TabItem Header="Chorus" Tag="COMMON-CHORUS-FRIENDLY">
                                                <local:StudioSetEffectEditorView DataContext="{Binding StudioSetChorusEditor}" />
                                            </TabItem>
                                            <TabItem Header="Reverb" Tag="COMMON-REVERB-FRIENDLY">
                                                <local:StudioSetEffectEditorView DataContext="{Binding StudioSetReverbEditor}" />
                                            </TabItem>
                                            <TabItem Header="Master EQ">
                                                <local:StudioSetMasterEqEditorView DataContext="{Binding StudioSetMasterEqEditor}" />
                                            </TabItem>
                                            <TabItem Header="Advanced">
                                                <TabControl TabStripPlacement="Top"
                                                            VerticalAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                    <!-- The raw grids the friendly Common tabs link to,
                                                         plus the raw Motional Surround set — its
                                                         friendly editor is the top-level Motional
                                                         Surround tab. -->
                                                    <TabItem Header="System" Tag="COMMON-SYSTEM">
                                                        <local:ParameterCollection Parameters="{Binding SystemParameters}"
                                                                                   SearchText="{Binding SearchTextSetup, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Studio Set" Tag="COMMON-STUDIO-SET">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetCommonParameters}"
                                                            SearchText="{Binding SearchTextStudioSetCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Chorus" Tag="COMMON-CHORUS">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetCommonChorusParameters}"
                                                            SearchText="{Binding SearchTextStudioSetCommonChorus, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Reverb" Tag="COMMON-REVERB">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetCommonReverbParameters}"
                                                            SearchText="{Binding SearchTextStudioSetCommonReverb, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Master EQ" Tag="COMMON-MASTER-EQ">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetCommonMasterEQParameters}"
                                                            SearchText="{Binding SearchTextStudioSetCommonMasterEQ, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Motional Surround" Tag="COMMON-MOTIONAL-SURROUND">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetCommonMotionalSurroundParameters}"
                                                            SearchText="{Binding SearchTextStudioSetCommonMotionalSurround, Mode=TwoWay}" />
                                                    </TabItem>
                                                </TabControl>
                                            </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                    <Grid Margin="10,5,0,0"
                                          IsVisible="{Binding IsPartTab}"
                                          ColumnDefinitions="Auto,*">

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <ToggleButton x:Name="PresetToggle"
                                                          IsChecked="True"
                                                          VerticalAlignment="Top"
                                                          Padding="6,2"
                                                          ToolTip.Tip="Show / hide the preset list"
                                                          Content="☰" />
                                            <!-- Disabled while the part loads. Changing the preset
                                                 mid-load leaves the load reading a tone the device is
                                                 about to drop, and its recovery then races the resync
                                                 the change itself starts. -->
                                            <local:PresetSelector SearchText="{Binding SearchTextPreset, Mode=TwoWay}"
                                                                  Presets="{Binding Presets}"
                                                                  SelectedPreset="{Binding SelectedPreset, Mode=TwoWay}"
                                                                  MaxWidth="640"
                                                                  VerticalAlignment="Stretch"
                                                                  VerticalContentAlignment="Stretch"
                                                                  IsEnabled="{Binding !IsLoading}"
                                                                  IsVisible="{Binding #PresetToggle.IsChecked}" />
                                        </StackPanel>

                                        <TabControl Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    TabStripPlacement="Top"
                                                    VerticalAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    behaviors:TabControlBehaviors.SelectTabByTag="{Binding ToneTabKey}"
                                                    behaviors:TabControlBehaviors.RepairSelections="{Binding ToneTypeKey}">
                                            <TabItem Header="Midi">
                                                <local:ParameterCollection
                                                    Parameters="{Binding StudioSetMidiParameters}"
                                                    SearchText="{Binding SearchTextStudioSetMidi, Mode=TwoWay}" />
                                            </TabItem>
                                            <!-- Tagged so the Layers tab's "Edit fades…" button can land here:
                                                 the four keyboard and velocity fade-width knobs the layer map
                                                 draws but does not drag are on this editor. The suffix follows
                                                 the COMMON-*-FRIENDLY convention the mixer's Chorus and Reverb
                                                 buttons navigate by, and keeps this distinct from the plain
                                                 SET-PART tag on the raw grid under "Advanced". -->
                                            <TabItem Header="Set Part" Tag="SET-PART-FRIENDLY">
                                                <local:StudioSetPartEditorView DataContext="{Binding StudioSetPartEditor}" />
                                            </TabItem>
                                            <TabItem Header="Set EQ">
                                                <local:StudioSetPartEqEditorView DataContext="{Binding StudioSetPartEqEditor}" />
                                            </TabItem>
                                            <TabItem Header="Editor"
                                                     Tag="PCMS"
                                                     IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                <local:PCMSynthToneEditorView DataContext="{Binding PcmSynthToneEditor}" />
                                            </TabItem>
                                            <TabItem Header="Editor"
                                                     Tag="PCMD"
                                                     IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                <local:PCMDrumKitEditorView DataContext="{Binding PcmDrumKitEditor}" />
                                            </TabItem>
                                            <TabItem Header="Editor"
                                                     Tag="SN-S"
                                                     IsVisible="{Binding SelectedPresetIsSNSynthTone}">
                                                <local:SNSynthToneEditorView DataContext="{Binding SNSynthToneEditor}" />
                                            </TabItem>
                                            <TabItem Header="Editor"
                                                     Tag="SN-A"
                                                     IsVisible="{Binding SelectedPresetIsSNAcousticTone}">
                                                <local:SNAcousticToneEditorView DataContext="{Binding SNAcousticToneEditor}" />
                                            </TabItem>
                                            <TabItem Header="Editor"
                                                     Tag="SN-D"
                                                     IsVisible="{Binding SelectedPresetIsSNDrumKit}">
                                                <local:SNDrumKitEditorView DataContext="{Binding SNDrumKitEditor}" />
                                            </TabItem>
                                            <TabItem Header="Advanced">
                                                <TabControl TabStripPlacement="Top"
                                                            VerticalAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                    <!-- The raw Studio Set Part / Part EQ grids the
                                                         friendly "Set Part" and "Set EQ" tabs link to.
                                                         Not tone-type specific, so always visible. -->
                                                    <TabItem Header="Part"
                                                             Tag="SET-PART">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetPartParameters}"
                                                            SearchText="{Binding SearchTextStudioSetPart, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Part EQ"
                                                             Tag="SET-PART-EQ">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding StudioSetPartEQParameters}"
                                                            SearchText="{Binding SearchTextStudioSetPartEQ, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Common"
                                                             Tag="PCM-SYN-COMMON"
                                                             IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMSynthToneCommonParameters}"
                                                            SearchText="{Binding SearchTextPCMSynthToneCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Common 2"
                                                             Tag="PCM-SYN-COMMON2"
                                                             IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMSynthToneCommon2Parameters}"
                                                            SearchText="{Binding SearchTextPCMSynthToneCommon2, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="MFX"
                                                             Tag="PCM-SYN-MFX"
                                                             IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMSynthToneCommonMFXParameters}"
                                                            SearchText="{Binding SearchTextPCMSynthToneCommonMFX, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="PMT"
                                                             Tag="PCM-SYN-PMT"
                                                             IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMSynthTonePMTParameters}"
                                                            SearchText="{Binding SearchTextPCMSynthTonePMT, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Kit"
                                                             Tag="PCMD-KIT"
                                                             IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMDrumKitCommonParameters}"
                                                            SearchText="{Binding SearchTextPCMDrumKitCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Kit extra"
                                                             Tag="PCMD-KIT2"
                                                             IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMDrumKitCommon2Parameters}"
                                                            SearchText="{Binding SearchTextPCMDrumKitCommon2, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="MFX"
                                                             Tag="PCMD-MFX"
                                                             IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMDrumKitCommonMFXParameters}"
                                                            SearchText="{Binding SearchTextPCMDrumKitCommonMFX, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Comp-EQ"
                                                             Tag="PCMD-COMPEQ"
                                                             IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding PCMDrumKitCompEQParameters}"
                                                            SearchText="{Binding SearchTextPCMDrumKitCompEQ, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Common"
                                                             Tag="SN-S-COMMON"
                                                             IsVisible="{Binding SelectedPresetIsSNSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNSynthToneCommonParameters}"
                                                            SearchText="{Binding SearchTextSNSynthToneCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="MFX"
                                                             Tag="SN-S-MFX"
                                                             IsVisible="{Binding SelectedPresetIsSNSynthTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNSynthToneCommonMFXParameters}"
                                                            SearchText="{Binding SearchTextSNSynthToneCommonMFX, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Tone"
                                                             Tag="SN-A-TONE"
                                                             IsVisible="{Binding SelectedPresetIsSNAcousticTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNAcousticToneCommonParameters}"
                                                            SearchText="{Binding SearchTextSNAcousticToneCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="MFX"
                                                             Tag="SN-A-MFX"
                                                             IsVisible="{Binding SelectedPresetIsSNAcousticTone}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNAcousticToneCommonMFXParameters}"
                                                            SearchText="{Binding SearchTextSNAcousticToneCommonMFX, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Kit"
                                                             Tag="SN-D-KIT"
                                                             IsVisible="{Binding SelectedPresetIsSNDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNDrumKitCommonParameters}"
                                                            SearchText="{Binding SearchTextSNDrumKitCommon, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="MFX"
                                                             Tag="SN-D-MFX"
                                                             IsVisible="{Binding SelectedPresetIsSNDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNDrumKitCommonMFXParameters}"
                                                            SearchText="{Binding SearchTextSNDrumKitCommonMFX, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Comp-EQ"
                                                             Tag="SN-D-COMPEQ"
                                                             IsVisible="{Binding SelectedPresetIsSNDrumKit}">
                                                        <local:ParameterCollection
                                                            Parameters="{Binding SNDrumKitCompEQParameters}"
                                                            SearchText="{Binding SearchTextSNDrumKitCompEQ, Mode=TwoWay}" />
                                                    </TabItem>
                                                    <TabItem Header="Partials"
                                                             Tag="PCM-SYN-PARTIALS"
                                                             IsVisible="{Binding SelectedPresetIsPCMSynthTone}">
                                                        <TabControl
                                                            SelectedIndex="{Binding AdvancedPartialIndex, Mode=TwoWay}"
                                                            ItemsSource="{Binding PcmSynthTonePartialViewModels}"
                                                            TabStripPlacement="Left">
                                                            <TabControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Header}" />
                                                                </DataTemplate>
                                                            </TabControl.ItemTemplate>
                                                            <TabControl.ContentTemplate>
                                                                <DataTemplate DataType="vm:PartialViewModel">
                                                                    <local:ParameterCollection
                                                                        Parameters="{Binding PartialParameters}"
                                                                        SearchText="{Binding SearchTextPartial, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </TabControl.ContentTemplate>
                                                        </TabControl>
                                                    </TabItem>
                                                    <TabItem Header="Partials"
                                                             Tag="PCMD-PARTIALS"
                                                             IsVisible="{Binding SelectedPresetIsPCMDrumKit}">
                                                        <TabControl
                                                            SelectedIndex="{Binding AdvancedPartialIndex, Mode=TwoWay}"
                                                            ItemsSource="{Binding PcmDrumKitPartialViewModels}"
                                                            TabStripPlacement="Left">
                                                            <TabControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Header}" />
                                                                </DataTemplate>
                                                            </TabControl.ItemTemplate>
                                                            <TabControl.ContentTemplate>
                                                                <DataTemplate DataType="vm:PartialViewModel">
                                                                    <local:ParameterCollection
                                                                        Parameters="{Binding PartialParameters}"
                                                                        SearchText="{Binding SearchTextPartial, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </TabControl.ContentTemplate>
                                                        </TabControl>
                                                    </TabItem>
                                                    <TabItem Header="Partials"
                                                             Tag="SN-S-PARTIALS"
                                                             IsVisible="{Binding SelectedPresetIsSNSynthTone}">
                                                        <TabControl
                                                            ItemsSource="{Binding SNSynthTonePartialViewModels}"
                                                            SelectedIndex="{Binding AdvancedPartialIndex, Mode=TwoWay}"
                                                            TabStripPlacement="Left">
                                                            <TabControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Header}" />
                                                                </DataTemplate>
                                                            </TabControl.ItemTemplate>
                                                            <TabControl.ContentTemplate>
                                                                <DataTemplate DataType="vm:PartialViewModel">
                                                                    <local:ParameterCollection
                                                                        Parameters="{Binding PartialParameters}"
                                                                        SearchText="{Binding SearchTextPartial, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </TabControl.ContentTemplate>
                                                        </TabControl>
                                                    </TabItem>
                                                    <!-- SNAcoustic doesn't have partials -->
                                                    <TabItem Header="Partials" Tag="SN-D-PARTIALS" IsVisible="{Binding SelectedPresetIsSNDrumKit}">
                                                        <TabControl
                                                            SelectedIndex="{Binding AdvancedPartialIndex, Mode=TwoWay}"
                                                            ItemsSource="{Binding SNDrumKitPartialViewModels}"
                                                            TabStripPlacement="Left">
                                                            <TabControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Header}" />
                                                                </DataTemplate>
                                                            </TabControl.ItemTemplate>
                                                            <TabControl.ContentTemplate>
                                                                <DataTemplate DataType="vm:PartialViewModel">
                                                                    <local:ParameterCollection
                                                                        Parameters="{Binding PartialParameters}"
                                                                        SearchText="{Binding SearchTextPartial, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </TabControl.ContentTemplate>
                                                        </TabControl>
                                                    </TabItem>
                                                </TabControl>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </TabItem>
            <!-- Order: Parameters, Mixer, Layers, Library, Motional Surround, SRX Loader — how often each is
                 reached for, most first. Parameters stays index 0 because OpenPartTab, OpenCommonTab and
                 OpenPartSetPartTab navigate to it by index; nothing else in the application depends on the
                 position of any of the others. Layers sits beside Mixer because the two answer neighbouring
                 questions about the same sixteen parts: how loud each one is, and where on the keyboard it
                 answers. Library comes after them because it is the one tab that is about files rather than
                 about the sound currently in the instrument — and before Motional Surround because a saved
                 sound is reached for far more often than a spatial layout. -->
            <TabItem Header="Mixer">
                <Panel>
                    <Panel IsVisible="{Binding MixerVm, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <local:MixerView DataContext="{Binding MixerVm}" />
                    </Panel>
                    <TextBlock Text="Connect to your Integra-7 to use the mixer."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding MixerVm, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                </Panel>
            </TabItem>
            <TabItem Header="Layers">
                <Panel>
                    <Panel IsVisible="{Binding LayerMapVm, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <local:LayerMapView DataContext="{Binding LayerMapVm}" />
                    </Panel>
                    <TextBlock Text="Connect to your Integra-7 to see the layer map."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding LayerMapVm, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                </Panel>
            </TabItem>
            <!-- No "connect your Integra-7" placeholder here, unlike the three tabs around it: the library is a
                 folder of files, so browsing, searching, rating and annotating all work with nothing plugged
                 in. Its view model is built once and never replaced, so there is nothing that can be null. Only
                 its Load button needs the instrument, and it says so itself when there is none. -->
            <TabItem Header="Library">
                <local:LibraryView DataContext="{Binding LibraryVm}" />
            </TabItem>
            <TabItem Header="Motional Surround">
                <Panel>
                    <Panel IsVisible="{Binding MotionalSurroundVm, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <local:MotionalSurroundView DataContext="{Binding MotionalSurroundVm}" />
                    </Panel>
                    <TextBlock Text="Connect to your Integra-7 to edit Motional Surround."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding MotionalSurroundVm, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                </Panel>
            </TabItem>
            <TabItem Header="SRX Loader">
                <local:SrxSelector />
            </TabItem>
        </TabControl>

        <!-- Status bar. Window-level rather than inside the Parameters tab, so the connection state
             stays visible on the SRX Loader and Motional Surround tabs too.

             The bottom padding is deliberately larger than the top's. This Border is the window's last
             grid row, so its lower edge is the window's own, and a window with ExtendsContentIntoTitleBar
             keeps a resize region a few pixels inside that edge which takes the pointer before whatever
             control is under it. With 4px all round, the lower band of these buttons fell inside that
             region: a click there did nothing whatever, and the button looked perfectly enabled, because
             it was — the click never reached it. 10px lifts them clear. Reported as "I often have to
             click Undo/Redo/Compare more than once", with no other button affected, which is what
             pointed here: these three are the only ones at the window's bottom edge. -->
        <Border Grid.Row="2"
                Background="{StaticResource SnPanelBackgroundBrush}"
                BorderBrush="{StaticResource SnStatusBarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4,10,10">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Undo lives here, in window chrome, and not in the Parameters tab's toolbar where it
                     started: there is one journal for the whole application, but Parameters, SRX Loader
                     and Motional Surround are sibling tabs, so a button inside one of them is missing
                     from the other two — and with no keyboard shortcut (see Window.KeyBindings above)
                     that left undo unreachable from the Motional Surround editor entirely.

                     IsEnabled follows the history, and also !IsSyncing. The history is the obvious half:
                     nothing can enter the journal while disconnected, so an empty history is the only
                     other reason to disable them. !IsSyncing is there for Compare, which is the one
                     operation that leaves the history looking untouched while it writes: it computes its
                     writes, streams them — hundreds, for a long session — and only then moves the journal,
                     so CanUndo is genuinely true throughout. An undo in that window moves the history
                     under the press, which the journal refuses rather than corrupts, but the user is left
                     with an abandoned Compare they did not connect to the undo. The overlay does not help:
                     it is a Border in grid row 1 and this status bar is row 2, so it cannot cover these. -->
                <!-- No ToolTip on any of these three, deliberately, and this is the fix for the reported
                     "I have to click Undo/Redo/Compare more than once".

                     A tooltip is a real popup window. When it sits under the pointer, the click goes to it
                     and is simply lost — the button never sees it, and looks perfectly enabled throughout,
                     which is what made this hard to place. It only bites once the tip has had time to
                     appear, so it was the unhurried, deliberate click that vanished.

                     ToolTip.Placement="Top" was tried first and did not fix it: observed still covering the
                     button with the window maximized. Rather than keep guessing at placements and offsets
                     that might merely make it rarer, there is no tip here at all. Nothing else in this
                     window is close enough to the pointer's resting place to have the same problem, so this
                     is not a rule against tooltips — it is a rule against tooltips on the controls a user
                     clicks repeatedly.

                     What the tips said is not lost. Undo and Redo say what they do. Compare's label names
                     the state it is in, and CompareAsync's status line explains what a press did and what
                     the next one will do — including that changes made while comparing are not kept, which
                     was the one fact only the tooltip carried. A status line is read; a tooltip has to be
                     hunted for. -->
                <Button Command="{Binding UndoAsync}" Padding="8,2">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="CanUndo" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    Undo
                </Button>
                <Button Command="{Binding RedoAsync}" Padding="8,2">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="CanRedo" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    Redo
                </Button>
                <!-- Compare. Beside Undo and Redo because it is the same history, read all the way to the
                     bottom in one press: there is nothing else to keep it in step with, and it is needed
                     from every tab for the reason the comment above gives. The label carries the state —
                     it is the only indication of which of the two sounds is playing — so no colour and no
                     style: every brush in this file comes from a resource, and an inline one here would be
                     wrong even for emphasis.

                     MinWidth is wide enough for the longer of the two labels, so pressing the button does
                     not resize it. Without that, "Hearing the original" shrank back to "Compare" under the
                     pointer and the next click landed where the button no longer was — the third strand of
                     the multiple-clicks report, and the one that explains why it depended on where in the
                     button you had clicked. -->
                <Button Command="{Binding CompareAsync}" Padding="8,2"
                        MinWidth="170"
                        Content="{Binding CompareLabel}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="CanCompare" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>

                <!-- Transport, moved here from the Parameters tab's toolbar. Same reasoning as Undo and
                     Redo above: these are wanted from any tab and at any moment, and a Panic button on a
                     tab you are not looking at is a Panic button you have to go and find. A rule off the
                     history buttons, because the two groups do unrelated things and a row of six
                     identical buttons reads as one group.

                     IsEnabled is Connected AND !IsSyncing, as it was in the toolbar: unlike the history
                     buttons these all send MIDI immediately, so there has to be a device and the wire has
                     to be free. -->
                <Rectangle Width="1" VerticalAlignment="Stretch" Margin="4,2"
                           Fill="{StaticResource SnStatusBarBorderBrush}" />
                <Button Command="{Binding PlayPhraseAsync}" Padding="8,2">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="Connected" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    Play Phrase
                </Button>
                <Button Command="{Binding StopPhraseAsync}" Padding="8,2">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="Connected" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    Stop Phrase
                </Button>
                <!-- Background from a resource, not the literal "Red" it carried in the toolbar: every
                     colour in this application lives in App.axaml, and a named colour breaks that rule
                     as thoroughly as a hex value would. -->
                <Button Command="{Binding PanicAsync}" Padding="8,2"
                        Background="{StaticResource PanicButtonBrush}"
                        Foreground="{StaticResource SnBadgeForegroundBrush}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="Connected" />
                                <Binding Path="!IsSyncing" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    Panic!
                </Button>

                <TextBlock Text="{Binding MidiDevices}" VerticalAlignment="Center" />
                <!-- Progress of the user tone names, which load after the window is usable.
                     Collapses to nothing once they are in. -->
                <TextBlock Text="{Binding BackgroundInfo}" VerticalAlignment="Center"
                           Foreground="{StaticResource SnMutedTextBrush}"
                           IsVisible="{Binding BackgroundInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- Outcome of the last Studio Set snapshot save/load. Two TextBlocks over the same
                     string rather than one: a failure has to be visibly wrong, and a success shown in
                     the same red would read as one. -->
                <TextBlock Text="{Binding SnapshotStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource SnMutedTextBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="SnapshotStatus"
                                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                <Binding Path="!SnapshotFailed" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Text="{Binding SnapshotStatus}" VerticalAlignment="Center"
                           Foreground="{StaticResource SnErrorTextBrush}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <MultiBinding.Bindings>
                                <Binding Path="SnapshotStatus"
                                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                <Binding Path="SnapshotFailed" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>