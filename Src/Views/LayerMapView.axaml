<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Integra7AuralAlchemist.ViewModels"
             xmlns:controls="using:Integra7AuralAlchemist.Controls"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="700"
             x:Class="Integra7AuralAlchemist.Views.LayerMapView"
             x:CompileBindings="True"
             x:DataType="vm:LayerMapViewModel">

    <!-- Sixteen parts' key and velocity ranges on one chart, with the selected part's numbers beneath it.

         No ToolTip anywhere on this page, and there must never be one. A tooltip is a real popup window: when
         it sits under the pointer the click goes to it and is simply lost, and this chart is nothing but click
         targets — a press selects, sounds a note, drags an edge or opens a tab. The status-bar comment in
         MainWindow.axaml is where that cost was paid the first time. What a tip would have said is written on
         the legend line below instead, where it is read rather than hunted for. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The legend. Everything the chart can be asked to do, in one line, because none of it is
             discoverable from a picture of sixteen rectangles. -->
        <TextBlock Grid.Row="0" Margin="10,8,10,6" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource SnMutedTextBrush}"
                   Text="One lane per part · key left to right, velocity as the box's height within its lane · drag an edge to change a range and the body to move it · click to select and hear that part at the note and velocity under the pointer (silence means the part does not answer there) · double-click to open the part." />

        <!-- The chart, given the whole of the tab between the legend and the readout.

             Deliberately not inside a ScrollViewer. Avalonia's scrollbars float over the content rather than
             reserving space beside it (see the memory note on this), so a vertical bar here would lie over the
             right-hand end of every lane — the top two octaves — and swallow presses on the one control in this
             application that is made entirely of press targets. The chart has nothing to scroll to in any case:
             it is always exactly sixteen lanes and always the full key range, and it scales into whatever height
             it is given. LayerMapControl's own MinHeight (LayerMapGeometry.MinHeight, sixteen legible lanes plus
             the note-name strip) is what keeps that from shrinking into illegibility.

             SelectedPart is TwoWay because the chart is the side that usually discovers it: a press lands in a
             lane and that lane is the selection, which is what the readout below is showing. The three events
             are wired in the code-behind rather than bound, the way MotionalSurroundView does it; they carry
             event arguments from Controls, and unpacking them there is what keeps this view model free of any
             knowledge of the control it is drawn by. -->
        <controls:LayerMapControl Grid.Row="1" x:Name="Map" Margin="10,0"
                                  Zones="{Binding Zones}"
                                  SelectedPart="{Binding SelectedPart, Mode=TwoWay}" />

        <!-- The readout: which part is selected, its four numbers, and the two places to go from here.

             Visibility follows HasSelection rather than testing the strings for emptiness, so a part whose tone
             name is genuinely empty — an unwritten user slot — is not mistaken for "nothing selected". -->
        <Border Grid.Row="2"
                Background="{StaticResource SnPanelBackgroundBrush}"
                BorderBrush="{StaticResource SnStatusBarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center"
                            IsVisible="{Binding HasSelection}">
                    <TextBlock Text="{Binding SelectionTitle}" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Keys" Foreground="{StaticResource SnMutedTextBrush}" />
                            <TextBlock Text="{Binding SelectionKeyRange}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Velocity" Foreground="{StaticResource SnMutedTextBrush}" />
                            <TextBlock Text="{Binding SelectionVelocityRange}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Fades" Foreground="{StaticResource SnMutedTextBrush}" />
                            <TextBlock Text="{Binding SelectionFades}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource SnMutedTextBrush}"
                           IsVisible="{Binding !HasSelection}"
                           Text="Click a lane to select a part." />

                <!-- Both buttons act on the selection, so neither exists until there is one.

                     Edit fades… is the whole of what the map offers in place of dragging a fade width: the four
                     knobs are on the part's own Set Part tab, and this lands on that tab with the part already
                     selected. It sits beside the fade numbers above it for that reason — the numbers say what
                     there is to change, and the button is where changing it happens. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding HasSelection}">
                    <Button Content="Open part" Padding="12,4" Command="{Binding OpenSelectedPart}" />
                    <Button Content="Edit fades…" Padding="12,4" Command="{Binding EditSelectedFades}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
